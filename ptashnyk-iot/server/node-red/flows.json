 {
  "id": "fn_check",
  "type": "function",
  "z": "tab_climate",
  "name": "Перевірка меж",
  "func": "// Перевірка граничних значень (розд. 2.2–2.3 звіту)\nconst d = msg.payload;\nconst zone = msg.topic.split('/')[2];\nconst problems = [];\nif (d.nh3 > 20) problems.push(`NH3 ${d.nh3} ppm > 20`);\nif (d.co2 > 3000) problems.push(`CO2 ${d.co2} ppm > 3000`);\nif (Math.abs(d.temp - d.setpoint) > 4) problems.push(`T ${d.temp} °C відхиляється від уставки ${d.setpoint} більш ніж на 4 °C`);\nif (problems.length === 0) return null;\n// не надсилати ту саму тривогу частіше ніж раз на 10 хв\nconst key = 'last_alarm_' + zone;\nconst now = Date.now();\nif (now - (context.get(key) || 0) < 600000) return null;\ncontext.set(key, now);\nmsg.topic = 'farm/h1/alarm';\nmsg.qos = 2;\nmsg.payload = { zone, time: new Date(now).toISOString(), problems };\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 360,
  "y": 60,
  "wires": [
   [
    "out_alarm",
    "dbg_alarm"
   ]
  ]
 },
