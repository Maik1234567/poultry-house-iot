 {
  "id": "fn_influx",
  "type": "function",
  "z": "tab_climate",
  "name": "У формат InfluxDB",
  "func": "// Запис у InfluxDB 2 (line protocol через HTTP API)\nconst d = msg.payload;\nconst zone = msg.topic.split('/')[2];\nconst f = ['temp','hum','nh3','co2','t_out','setpoint','vent_m3s','heater_w']\n  .filter(k => typeof d[k] === 'number').map(k => `${k}=${d[k]}`).join(',');\nmsg.url = env.get('INFLUX_URL') + '/api/v2/write?org=farm&bucket=climate&precision=s';\nmsg.method = 'POST';\nmsg.headers = { 'Authorization': 'Token ' + env.get('INFLUX_TOKEN'), 'Content-Type': 'text/plain' };\nmsg.payload = `climate,house=h1,zone=${zone},mode=${d.mode} ${f} ${d.ts}`;\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 370,
  "y": 180,
  "wires": [
   [
    "http_influx"
   ]
  ]
 },
